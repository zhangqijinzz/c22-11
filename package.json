{
  "name": "ruleweave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18 <=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
