    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/parser": "8.29.1",
    "@typescript-eslint/eslint-plugin": "8.29.1",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.24.0",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "typescript": "5.8.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
